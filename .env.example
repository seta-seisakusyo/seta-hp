# Docker Compose がリポジトリ直下から読み込む環境変数。
#   cp .env.example .env
# アプリ固有の設定は next/.env.example を next/.env にコピーする。

# ローカルDocker開発環境（docker-compose.override.yml）
DEV_BIND_ADDRESS=0.0.0.0
DEV_PORT=3001
DEV_NEXTAUTH_URL=http://192.168.11.8:3001

# デプロイするコンテナイメージ
IMAGE_TAG=latest

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass

# 公開URL・ドメイン
NEXTAUTH_URL=https://kaza-love.com
SERVER_NAME=kaza-love.com
OLD_SERVER_NAME=setaseisakusyo.com

# Designer SSO（Designer側と同じ共有秘密を設定）
PROXY_SSO_SECRET=

# 管理ページ・管理APIを許可するIP/CIDR（スペース区切り、空なら制限なし）
ADMIN_ALLOWED_IPS=
