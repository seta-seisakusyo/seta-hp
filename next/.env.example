# =========================================
# 飾Love (運営: 瀬田製作所) - .env テンプレート
# =========================================
# このファイルをコピーして next/.env を作成し、各値を設定してください:
#   cp next/.env.example next/.env
#
# 注意:
# - .env は .gitignore 済み。シークレットを含めて絶対にコミットしないこと
# - 本番環境では .env をサーバー上で直接管理し、リポジトリには本ファイルのみ保持

# ---- Database ----
# Docker Composeではdocker-compose.ymlのDATABASE_URLが優先されます
DATABASE_URL="mysql://app_user:app_pass@mysql:3306/app_db"

# ---- Rate Limit Store (任意) ----
# 省略時は本番/DB接続時に database、それ以外は memory を自動選択
# RATE_LIMIT_STORE="database"


# ---- NextAuth (必須) ----
# 32バイトのランダム値を生成: openssl rand -base64 32
AUTH_SECRET=""
# Docker Composeではルート.envのNEXTAUTH_URLが優先されます。
# 直接 yarn dev を実行する場合はこのURLを使用します。
NEXTAUTH_URL="http://localhost:3000"

# ---- SSO / Designer (任意) ----
# 親ドメイン配下のDesignerへNextAuthセッションを共有する本番設定
# SSO_COOKIE_DOMAIN=".kaza-love.com"
# SSO_COOKIE_SECURE="1"
# SSO_VERIFY_ENABLED="1"
# NEXT_PUBLIC_DESIGNER_URL="https://designer.kaza-love.com"

# ---- 設計ツールからの商品登録 (任意) ----
# Designer の HP_API_SECRET と同じ値。未設定なら /api/integrations/designer/products は 503。
# 生成: openssl rand -hex 32
# DESIGNER_API_SECRET=""

# ---- 社内レビューコメント (任意) ----
# true の環境だけUIとAPIを有効化
# NEXT_PUBLIC_ENABLE_COMMENTS="true"

# Googleアナリティクス4 の測定ID（任意）。
# 設定した環境でだけ gtag.js を読み込む。未設定なら計測タグは一切描画されない。
# 形式は G-XXXXXXXXXX。一致しない値は無視される。
#
# ここでの設定はローカル開発（yarn dev）用。
# 本番は GitHub のリポジトリ変数からCIがビルド引数として渡すため、
# 本番サーバの .env には置かない。詳細は README の環境変数の節を参照。
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---- 管理者シード (任意。npx prisma db seed で使用) ----
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# ---- Google OAuth (任意) ----
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# ---- reCAPTCHA v3 (任意 / 問い合わせフォームで使用) ----
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# ALLOWED_RECAPTCHA_HOSTNAMES="localhost"

# ---- SMTP (任意 / メール送信を使う場合) ----
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# CONTACT_TO_EMAIL=""

# ---- X (旧Twitter) 連携 (任意 / 管理画面からの手動投稿。未設定なら投稿機能は無効) ----
# API_KEY / API_SECRET は開発者アプリの資格情報で、別アプリと共用できる。
# ACCESS_TOKEN / ACCESS_TOKEN_SECRET が投稿先アカウント(@kaza_love_)を決める。
# Developer Portal の「Generate」では開発者本人のトークンしか発行されないため、
# @kaza_love_ 用は 3-legged OAuth で取得すること（アプリ権限は Read and Write が必須）。
# X_API_KEY=""
# X_API_SECRET=""
# X_ACCESS_TOKEN=""
# X_ACCESS_TOKEN_SECRET=""
