generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String   @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  User                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String
  phone     String
  inquiry   String   @db.Text
  userId    String?
  User      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model News {
  id       Int      @id @default(autoincrement())
  date     DateTime
  title    String
  contents Json
  url      String?

  @@index([date])
}

model Product {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String   @db.Text
  price       Int
  category    String
  tags        String
  images      Json?
  stock       String   @default("在庫あり")
  isPublished Boolean  @default(true)
  isHeroImage Boolean  @default(false)
  purchaseUrl String?
  amazonUrl   String?  @db.VarChar(512)
  works       WorkProduct[]

  @@index([category])
  @@index([isPublished, createdAt])
  @@index([isHeroImage, isPublished])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  password      String?
  email         String?   @unique
  emailVerified DateTime?
  role          User_role @default(VIEWER)
  image         String?
  Account       Account[]
  Inquiry       Inquiry[]
}

model Work {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  title       String
  description String   @db.Text
  category    String
  tags        String
  image       String?
  isPublished Boolean  @default(true)
  products    WorkProduct[]

  @@index([category])
  @@index([isPublished, createdAt])
}

// ギャラリー作品とそれに使った商品の紐づけ（多対多）。
// 商品詳細の「この商品を使った展示例」とギャラリーの「この展示に使った商品」の相互リンクに使う。
model WorkProduct {
  workId    Int
  productId Int
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([workId, productId])
  @@index([productId])
}

enum User_role {
  ADMIN
  EDITOR
  VIEWER
}

// 社内レビュー用ページ内コメント (env: NEXT_PUBLIC_ENABLE_COMMENTS=true の時のみ有効)
model ReviewComment {
  id         Int                  @id @default(autoincrement())
  createdAt  DateTime             @default(now())
  pageUrl    String
  xRatio     Float
  yAbsolute  Float
  authorName String
  content    String               @db.Text
  status     String               @default("open") // "open" | "resolved"
  replies    ReviewCommentReply[]

  @@index([pageUrl])
}

model ReviewCommentReply {
  id         Int           @id @default(autoincrement())
  createdAt  DateTime      @default(now())
  commentId  Int
  comment    ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorName String
  content    String        @db.Text

  @@index([commentId])
}

model ApiRateLimit {
  id         Int      @id @default(autoincrement())
  identifier String   @unique @db.VarChar(191)
  count      Int
  resetAt    DateTime

  @@index([resetAt])
}
